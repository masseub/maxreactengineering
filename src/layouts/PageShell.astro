---
import '../styles/global.css';
import type { Locale } from '../data/content';

interface Props {
  lang: Locale;
  t: any;
  meta: {
    title: string;
    description: string;
    locale: string;
  };
}

const { lang, t, meta } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.startsWith('/') ? path.slice(1) : path}`;
const altLang = lang === 'fr' ? 'en' : 'fr';
const altHref = withBase(`${altLang}/`);
const canonical = withBase(`${lang}/`);
const siteUrl = Astro.site?.toString();
const canonicalUrl = siteUrl ? new URL(canonical, siteUrl).toString() : canonical;
const skipLabel = lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content';
const topAnchor = '#top';
const backToTopLabel = lang === 'fr' ? 'Revenir en haut de la page' : 'Back to top';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta property="og:image" content={siteUrl ? new URL(withBase('logo.png'), siteUrl).toString() : withBase('logo.png')} />
    <link rel="icon" type="image/png" href={withBase('logo.png')} />
    <link rel="alternate" hrefLang={lang} href={canonicalUrl} />
    <link rel="alternate" hrefLang={altLang} href={siteUrl ? new URL(altHref, siteUrl).toString() : altHref} />
    <link rel="alternate" hrefLang="x-default" href={siteUrl ? new URL(withBase('fr/'), siteUrl).toString() : withBase('fr/')} />
  </head>
  <body id="top" class="bg-slate-50 text-slate-800 antialiased min-h-screen font-sans">
    <a href="#main" class="skip-link">{skipLabel}</a>

    <header class="bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <a
            href={topAnchor}
            aria-label={backToTopLabel}
            class="inline-block shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
          >
            <img src={withBase('logo.png')} alt="MaxReact Engineering logo" class="h-[200px] w-[200px]" />
          </a>
          <div>
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">MaxReact Engineering</p>
            <p class="text-sm font-semibold text-sky-900">{t.headerTagline}</p>
          </div>
        </div>
        <nav class="flex items-center gap-6 text-sm font-medium">
          <a class="nav-link" href="#approach">{t.nav.approach}</a>
          <a class="nav-link" href="#coverage">{t.nav.coverage}</a>
          <a class="nav-link" href="#results">{t.nav.results}</a>
          <a class="btn-ghost" href="#contact">{t.nav.contact}</a>
          <div class="h-6 w-px bg-slate-200" aria-hidden="true"></div>
          <div class="flex items-center gap-2 text-slate-600" aria-label="Language switcher">
            <a
              href={withBase('fr/')}
              class={`hover:text-sky-900 transition ${lang === 'fr' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
            >
              FR
            </a>
            <span class="text-slate-400">|</span>
            <a
              href={withBase('en/')}
              class={`hover:text-sky-900 transition ${lang === 'en' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
            >
              EN
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="max-w-6xl mx-auto px-6 pt-12 pb-16 space-y-20">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-100">
      <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center gap-3">
          <a
            href={topAnchor}
            aria-label={backToTopLabel}
            class="inline-block shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
          >
            <img src={withBase('logo.png')} alt="MaxReact Engineering logo" class="h-[180px] w-[180px]" />
          </a>
          <div>
            <p class="text-sm font-semibold">MaxReact Engineering</p>
            <p class="text-xs text-slate-300">{t.footer.note}</p>
          </div>
        </div>
        <div class="text-sm text-slate-300">
          <p>{t.footer.location}</p>
          <p class="text-slate-400">© {new Date().getFullYear()} MaxReact Engineering</p>
        </div>
      </div>
    </footer>
  </body>
</html>
