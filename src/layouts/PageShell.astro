---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import type { Locale, Copy } from '../data/content';

interface Props {
  lang: Locale;
  t: Copy;
  meta: {
    title: string;
    description: string;
    locale: string;
  };
}

const { lang, t, meta } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.startsWith('/') ? path.slice(1) : path}`;
const altLang = lang === 'fr' ? 'en' : 'fr';
const altHref = withBase(`${altLang}/`);
const canonical = withBase(`${lang}/`);
const siteUrl = Astro.site?.toString();
const canonicalUrl = siteUrl ? new URL(canonical, siteUrl).toString() : canonical;
const skipLabel = t.layout.skipToContent;
const topAnchor = '#top';
const backToTopLabel = t.layout.backToTop;
const logoAlt = t.layout.logoAlt;
const brandName = t.layout.brandName;
const languageSwitcherLabel = t.layout.languageSwitcher;
const menuLabel = lang === 'fr' ? 'Menu' : 'Menu';
---

<!doctype html>
<html lang={lang}>
  <head>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D8KSLZDHSS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-D8KSLZDHSS');
    </script>


    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta property="og:image" content={siteUrl ? new URL(withBase('logo.png'), siteUrl).toString() : withBase('logo.png')} />
    <link rel="icon" type="image/png" href={withBase('logo.png')} />
    <link rel="alternate" hrefLang={lang} href={canonicalUrl} />
    <link rel="alternate" hrefLang={altLang} href={siteUrl ? new URL(altHref, siteUrl).toString() : altHref} />
    <link rel="alternate" hrefLang="x-default" href={siteUrl ? new URL(withBase('fr/'), siteUrl).toString() : withBase('fr/')} />
  
  </head>
  <body id="top" class="bg-slate-50 text-slate-800 antialiased min-h-screen font-sans">
    
    <a href="#main" class="skip-link">{skipLabel}</a>

    <header class="site-header bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 md:py-3">
        <div class="flex items-center justify-between gap-3 md:gap-6">
          <div class="min-w-0 flex items-center gap-2 sm:gap-3">
            <a
              href={topAnchor}
              aria-label={backToTopLabel}
              class="inline-block shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
            >
              <Image
                src={logoImage}
                alt={logoAlt}
                class="h-14 w-14 sm:h-16 sm:w-16 md:h-20 md:w-20"
                widths={[56, 64, 80, 96, 120, 160]}
                sizes="(max-width: 640px) 56px, (max-width: 768px) 64px, (max-width: 1024px) 80px, 96px"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                format="webp"
              />
            </a>
            <div class="min-w-0">
              <p class="text-[0.62rem] sm:text-xs uppercase tracking-[0.15em] text-slate-500 break-words">{brandName}</p>
              <p class="hidden min-[390px]:block text-xs sm:text-sm font-semibold text-sky-900">{t.headerTagline}</p>
            </div>
          </div>

          <nav class="hidden md:flex items-center gap-2 lg:gap-4 text-sm font-medium">
            <a class="nav-link" href="#approach">{t.nav.approach}</a>
            <a class="nav-link" href="#coverage">{t.nav.coverage}</a>
            <a class="nav-link" href="#results">{t.nav.results}</a>
            <a class="btn-ghost" href="#contact">{t.nav.contact}</a>
            <div class="h-6 w-px bg-slate-200" aria-hidden="true"></div>
            <div class="flex items-center gap-2 text-slate-600" aria-label={languageSwitcherLabel}>
              <a
                href={withBase('fr/')}
                class={`hover:text-sky-900 transition ${lang === 'fr' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
              >
                FR
              </a>
              <span class="text-slate-400">|</span>
              <a
                href={withBase('en/')}
                class={`hover:text-sky-900 transition ${lang === 'en' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
              >
                EN
              </a>
            </div>
          </nav>

          <details class="mobile-menu relative md:hidden" name="mobile-nav">
            <summary class="menu-summary" aria-label={menuLabel}>{menuLabel}</summary>
            <nav class="mobile-menu-panel" aria-label={menuLabel}>
              <a class="mobile-nav-link" href="#approach">{t.nav.approach}</a>
              <a class="mobile-nav-link" href="#coverage">{t.nav.coverage}</a>
              <a class="mobile-nav-link" href="#results">{t.nav.results}</a>
              <a class="mobile-nav-link" href="#contact">{t.nav.contact}</a>
              <div class="mx-4 h-px bg-slate-200" aria-hidden="true"></div>
              <div class="flex items-center justify-between gap-4 px-4 py-3 text-sm text-slate-600">
                <span class="truncate">{languageSwitcherLabel}</span>
                <div class="flex items-center gap-2">
                  <a
                    href={withBase('fr/')}
                    class={`hover:text-sky-900 transition ${lang === 'fr' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
                  >
                    FR
                  </a>
                  <span class="text-slate-400">|</span>
                  <a
                    href={withBase('en/')}
                    class={`hover:text-sky-900 transition ${lang === 'en' ? 'text-sky-900 font-semibold' : 'text-slate-500'}`}
                  >
                    EN
                  </a>
                </div>
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 md:pt-12 pb-12 md:pb-16 space-y-14 md:space-y-20">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center gap-3">
          <a
            href={topAnchor}
            aria-label={backToTopLabel}
            class="inline-block shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
          >
            <Image
              src={logoImage}
              alt={logoAlt}
              class="h-14 w-14 sm:h-16 sm:w-16 md:h-[96px] md:w-[96px]"
              widths={[56, 64, 96, 108]}
              sizes="(max-width: 640px) 56px, (max-width: 768px) 64px, 96px"
              loading="lazy"
              decoding="async"
              format="webp"
            />
          </a>
          <div>
            <p class="text-sm font-semibold">{brandName}</p>
            <p class="text-xs text-slate-300">{t.footer.note}</p>
          </div>
        </div>
        <div class="text-sm text-slate-300">
          <p>{t.footer.location}</p>
          <p class="text-slate-400">{t.footer.copyrightPrefix} {new Date().getFullYear()} {brandName}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      const mobileMenu = document.querySelector('.mobile-menu');

      if (mobileMenu) {
        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.removeAttribute('open');
          });
        });

        document.addEventListener('click', (event) => {
          if (!mobileMenu.hasAttribute('open')) {
            return;
          }

          if (event.target instanceof Node && !mobileMenu.contains(event.target)) {
            mobileMenu.removeAttribute('open');
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            mobileMenu.removeAttribute('open');
          }
        });
      }
    </script>
  </body>
</html>
